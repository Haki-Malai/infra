aws_region                = "us-east-1"
github_owner             = "Haki-Malai"
infrastructure_repository = "infra"
domain_name              = "hakimalai.com"

# Confirm budget scope and set the real recipient outside source control:
# export TF_VAR_budget_alert_email='your-address@example.com'
budget_scope = "account"
monthly_budget_usd = 5
budget_alert_usd = 2.5

# Set true only after deployment.json and assets have been checked on CloudFront.
packetloss_production_dns_enabled = false

# If IAM already contains GitHub's OIDC provider, reuse its ARN instead of creating it.
# github_oidc_provider_arn = "arn:aws:iam::975050102915:oidc-provider/token.actions.githubusercontent.com"

packetloss_stages = {
  dev = {
    branch        = "dev"
    subdomain     = "dev.packetloss"
    build_mode    = "development"
    vite_game_env = "DEFAULT"
  }
  prod = {
    branch        = "main"
    subdomain     = "packetloss"
    build_mode    = "production"
    vite_game_env = "DEFAULT"
  }
}

map $http_upgrade $packetloss_connection {
  default upgrade;
  '' close;
}
server {
  listen 443 ssl;
  server_name ${hostname};
  ssl_certificate /etc/packetloss/tls/current/fullchain.pem;
  ssl_certificate_key /etc/packetloss/tls/current/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  server_tokens off;
  client_max_body_size 16k;
  access_log off;
  location /admin { return 404; }
  location /internal { return 404; }
  location / {
    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $packetloss_connection;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_read_timeout 75s;
  }
}
